{
  "plugin": "enterprise-ai-harness",
  "version": "0.4.2",
  "stages": [
    "intake",
    "grill",
    "impact",
    "plan",
    "implement",
    "verify"
  ],
  "artifacts": {
    "intake": [
      "requirement.md"
    ],
    "grill": [
      "clarifications.md"
    ],
    "impact": [
      "impact.md",
      "impact.json"
    ],
    "plan": [
      "plan.md"
    ],
    "implement": [
      "progress.md"
    ],
    "verify": [
      "verification.md"
    ]
  },
  "budgets": {
    "orchestrator": {
      "tool_calls": 30
    },
    "check": {
      "tool_calls": 20
    },
    "intake": {
      "tool_calls": 20
    },
    "grill": {
      "tool_calls": 40
    },
    "impact": {
      "tool_calls": 80,
      "output_kb": 200
    },
    "scout": {
      "tool_calls": 25
    },
    "plan": {
      "tool_calls": 40
    },
    "implement": {
      "tool_calls": 300,
      "output_kb": 600
    },
    "implement-task": {
      "tool_calls": 30,
      "output_kb": 200
    },
    "verify": {
      "tool_calls": 40
    },
    "cross-check": {
      "tool_calls": 40
    }
  },
  "review": {
    "intake": "required",
    "grill": "required",
    "impact": "required",
    "plan": "required",
    "implement": "per-task",
    "verify": "required"
  },
  "hooks": {
    "audit": false,
    "edit_tools": "(edit|create|write|replace|insert|patch|delete|rename|move)",
    "terminal_tools": "(terminal|runInTerminal|run_in_terminal|execute|command)",
    "subagent_tools": "(subagent|runSubagent)",
    "out_of_plan_files": "ask"
  },
  "runs": {
    "dir": ".ai-harness",
    "commit": false
  },
  "code_index": {
    "dir": ".codegraph",
    "file": "codegraph.db",
    "sync": "npx -y @colbymchenry/codegraph@1.6.1 sync --quiet",
    "seed_dir": ".codegraph-seed",
    "seed_refresh": "stale",
    "seed_max_age_days": 7
  },
  "agent_scopes": {
    "Change Orchestrator": "orchestrator",
    "Harness Check": "check",
    "Intake": "intake",
    "Griller": "grill",
    "Impact Analyst": "impact",
    "Component Scout": "scout",
    "Planner": "plan",
    "Implementer": "implement",
    "Task Runner (fast)": "implement-task",
    "Task Runner (standard)": "implement-task",
    "Task Runner (deep)": "implement-task",
    "Plan Checker": "cross-check",
    "Impact Checker": "cross-check",
    "Reviewer": "verify"
  },
  "models": {
    "order": [
      "fast",
      "standard",
      "deep"
    ],
    "first_model": {
      "fast": "Claude Haiku 4.5 (copilot)",
      "standard": "Claude Sonnet 5.5 (copilot)",
      "deep": "Claude Opus 5.5 (copilot)"
    },
    "scope_tiers": {
      "orchestrator": "fast",
      "check": "fast",
      "intake": "fast",
      "grill": "deep",
      "impact": "deep",
      "scout": "fast",
      "plan": "standard",
      "implement": "standard",
      "verify": "standard"
    },
    "task_runners": {
      "Task Runner (fast)": "fast",
      "Task Runner (standard)": "standard",
      "Task Runner (deep)": "deep"
    },
    "task_default": "standard",
    "cross_check": {
      "plan": {
        "checker": "deep",
        "required": true
      },
      "impact": {
        "checker": "deep",
        "required": false
      }
    }
  }
}
