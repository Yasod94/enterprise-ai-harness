{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "github-ro": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "repos,pull_requests,issues",
        "X-MCP-Readonly": "true"
      }
    },
    "github-rw": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "X-MCP-Toolsets": "pull_requests,issues",
        "X-MCP-Tools": "create_pull_request,update_pull_request,add_issue_comment"
      }
    },
    "atlassian": {
      "type": "streamable-http",
      "url": "https://mcp.atlassian.com/v2/mcp"
    },
    "codegraph": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@colbymchenry/codegraph@1.6.1",
        "serve",
        "--mcp"
      ],
      "env": {
        "DO_NOT_TRACK": "1",
        "CODEGRAPH_MCP_TOOLS": "explore,node,search,callers,callees,impact"
      }
    },
    "ctx": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "context-mode@1.0.169"
      ]
    }
  }
}
